{
    email your-email@example.com
}

# Global Basic Auth configuration helper
(basic-auth-auth) {
    basic_auth {
        # Username: admin
        # Replace the placeholder below with your generated bcrypt hash.
        # Generate hash with: docker run --rm caddy caddy hash-password --plaintext <your-password>
        admin YOUR_GENERATED_BCRYPT_HASH_HERE
    }
}

your-ddns-domain.tplinkdns.com {
    # Optional: If port 80 is forwarded to another machine/service on your network,
    # uncomment below to force Caddy to use the TLS-ALPN challenge on port 443 instead.
    # tls {
    #     issuer acme {
    #         disable_http_challenge
    #     }
    # }

    import basic-auth-auth

    # Service routes. Each entry is a `redir` that enforces the trailing slash
    # (so relative assets resolve) plus a `handle_path` that strips the prefix
    # before proxying. Bridge containers are addressed by container name on the
    # web-proxy network; host-mode ones via host.docker.internal.
    #
    # ./add-service.sh appends new routes right before the end marker, so keep
    # both marker lines in place. Hand-editing between them is fine too — Caddy
    # runs with --watch and reloads the file on its own.

    # >>> caddy-proxy:routes (managed by add-service.sh — keep this marker)
    redir /helendatacollector /helendatacollector/
    handle_path /helendatacollector* {
        reverse_proxy helen-collector:3000
    }

    redir /eleniadatacollector /eleniadatacollector/
    handle_path /eleniadatacollector* {
        reverse_proxy elenia-collector:3000
    }

    redir /ruuvigateway /ruuvigateway/
    handle_path /ruuvigateway* {
        reverse_proxy host.docker.internal:8080
    }

    redir /fingridflow /fingridflow/
    handle_path /fingridflow* {
        reverse_proxy fingrid-collector:3000
    }
    # <<< caddy-proxy:routes (end of managed routes)

    # Fallback root page: the portal, plus the services.json it renders from.
    handle {
        root * /srv
        file_server
    }
}
